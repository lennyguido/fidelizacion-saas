# Copiar este archivo a .env.local y completar los valores.
# .env.local NO se sube al repositorio.
#
# Solo van acá variables PÚBLICAS (todo lo que empieza con VITE_ termina en el navegador).
# NUNCA poner la service_role key ni ningún secret en el frontend.

# Supabase > Project Settings > API (proyecto de DESARROLLO, no producción)
VITE_SUPABASE_URL=
# Publishable key (o "anon key" en proyectos viejos)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional. Dirección pública de la tarjeta del cliente (por ejemplo https://mi-tarjeta.pages.dev).
# En local y en Codespaces no hace falta: se usa el puerto 5174. En el hosting sí (docs/DEPLOY.md).
# VITE_CLIENT_APP_URL=

# Número de WhatsApp de ventas para el botón "Pasar a <plan>" (solo dígitos, con código de país).
# VITE_SALES_WHATSAPP=5491128330853
