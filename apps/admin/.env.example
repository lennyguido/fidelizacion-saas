# Copiar este archivo a .env.local y completar los valores.
# .env.local NO se sube al repositorio.
#
# Solo van acá variables PÚBLICAS (todo lo que empieza con VITE_ termina en el navegador).
# NUNCA poner la service_role key ni ningún secret en el frontend.

# Supabase > Project Settings > API (proyecto de DESARROLLO, no producción)
VITE_SUPABASE_URL=
# Publishable key (o "anon key" en proyectos viejos)
VITE_SUPABASE_PUBLISHABLE_KEY=
